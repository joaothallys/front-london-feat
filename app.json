{
  "expo": {
    "name": "LumenFit",
    "slug": "lumenfit",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "londonfitness",
      "com.londonfitness.app",
      "com.googleusercontent.apps.1053297902526-k4ugspt500kb8re2u2jok3d2dv57v37h"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.londonfitness.app",
      "appleTeamId": "2572AZCAGV",
      "buildNumber": "19",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.londonfitness.app"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "O LumenFit usa a câmera para a foto do seu treino.",
        "NSPhotoLibraryUsageDescription": "O LumenFit acessa suas fotos para montar o card do treino.",
        "NSPhotoLibraryAddUsageDescription": "O LumenFit salva a montagem do treino na sua galeria.",
        "NSBonjourServices": [
          "_http._tcp",
          "_expo._tcp"
        ],
        "NSFaceIDUsageDescription": "O LumenFit usa o Face ID para desbloquear o app no iPhone.",
        "NSLocalNetworkUsageDescription": "O LumenFit usa a rede local para carregar o app a partir do computador de desenvolvimento.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "UIRequiresFullScreen": true,
        "UIRequiredDeviceCapabilities": [
          "arm64"
        ],
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "package": "com.londonfitness.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "O LumenFit acessa suas fotos para montar o card do treino.",
          "savePhotosPermission": "O LumenFit salva a montagem do treino na sua galeria.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O LumenFit acessa suas fotos para montar o card do treino.",
          "cameraPermission": "O LumenFit usa a câmera para a foto do seu treino."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O LumenFit usa o Face ID para desbloquear o app no iPhone."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/rest-done.wav"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.londonfitness.app.widgets",
          "groupIdentifier": "group.com.londonfitness.app",
          "frequentUpdates": true,
          "widgets": [
            {
              "name": "WorkoutLockWidget",
              "displayName": "LumenFit Treino",
              "description": "Veja o intervalo e o exercício atual na tela de bloqueio.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline",
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      "expo-audio",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "minha-empresa-dt",
          "project": "lumenfit"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
