{
  "expo": {
    "name": "LumenFit",
    "slug": "lumenfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "londonfitness",
      "com.londonfitness.app",
      "com.googleusercontent.apps.1053297902526-k4ugspt500kb8re2u2jok3d2dv57v37h"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.londonfitness.app",
      "infoPlist": {
        "NSCameraUsageDescription": "O LumenFit usa a câmera para a foto do seu treino.",
        "NSPhotoLibraryUsageDescription": "O LumenFit acessa suas fotos para montar o card do treino.",
        "NSPhotoLibraryAddUsageDescription": "O LumenFit salva a montagem do treino na sua galeria.",
        "NSFaceIDUsageDescription": "O LumenFit usa o Face ID para desbloquear o app no iPhone.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "package": "com.londonfitness.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "O LumenFit acessa suas fotos para montar o card do treino.",
          "cameraPermission": "O LumenFit usa a câmera para a foto do seu treino."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O LumenFit usa o Face ID para desbloquear o app no iPhone."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
